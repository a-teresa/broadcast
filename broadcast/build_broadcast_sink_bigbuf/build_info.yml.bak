cmake:
  board:
    name: 'aurascope'
    path:
     - '/home/t/asset-tracker-template/nrf/boards/aurascope/aurascope'
    qualifiers: 'nrf5340/cpuapp'
    revision: ''
  images:
   - name: 'nrf5340_audio'
     source-dir: '/home/t/asset-tracker-template/nrf/applications/nrf5340_audio'
     type: 'MAIN'
   - name: 'mcuboot'
     source-dir: '/home/t/asset-tracker-template/bootloader/mcuboot/boot/zephyr'
     type: 'BOOTLOADER'
   - name: 'ipc_radio'
     source-dir: ''
   - name: 'b0n'
     source-dir: ''
  kconfig:
    files:
     - '/home/t/asset-tracker-template/nrf/applications/nrf5340_audio/build_broadcast_sink_bigbuf/_sysbuild/empty.conf'
     - '/home/t/asset-tracker-template/nrf/applications/nrf5340_audio/sysbuild_fota.conf'
    user-files:
     - '/home/t/asset-tracker-template/nrf/applications/nrf5340_audio/sysbuild_fota.conf'
version: '0.1.0'
west:
  command: '/home/t/asset-tracker-template/.venv/bin/west build -b aurascope/nrf5340/cpuapp -d build_broadcast_sink_bigbuf -- -DEXTRA_CONF_FILE=broadcast_sink/overlay-broadcast_sink.conf -DCONFIG_AUDIO_SINK_USB=y -DFILE_SUFFIX=fota -DEXTRA_DTC_OVERLAY_FILE=boards/aurascope_usb_mic_only.overlay -DCONFIG_DEVICE_LOCATION_SET_COMPILE_TIME=y -DCONFIG_DEVICE_LOCATION_AT_COMPILE_TIME=3 -DCONFIG_FIFO_TX_FRAME_COUNT=6'
  topdir: '/home/t/asset-tracker-template'
  version: '1.5.0'
