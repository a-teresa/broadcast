cmake:
  board:
    name: 'aurascope'
    path:
     - '/home/t/asset-tracker-template/nrf/boards/aurascope/aurascope'
    qualifiers: 'nrf5340/cpuapp'
    revision: ''
  images:
   - name: 'nrf5340_audio'
     source-dir: '/home/t/asset-tracker-template/nrf/applications/nrf5340_audio'
     type: 'MAIN'
   - name: 'mcuboot'
     source-dir: '/home/t/asset-tracker-template/bootloader/mcuboot/boot/zephyr'
     type: 'BOOTLOADER'
   - name: 'ipc_radio'
     source-dir: ''
   - name: 'b0n'
     source-dir: ''
  kconfig:
    files:
     - '/home/t/asset-tracker-template/nrf/applications/nrf5340_audio/build_broadcast_source_i2s/_sysbuild/empty.conf'
     - '/home/t/asset-tracker-template/nrf/applications/nrf5340_audio/sysbuild_fota.conf'
    user-files:
     - '/home/t/asset-tracker-template/nrf/applications/nrf5340_audio/sysbuild_fota.conf'
version: '0.1.0'
west:
  command: '/home/t/asset-tracker-template/.venv/bin/west build -b aurascope/nrf5340/cpuapp -d build_broadcast_source_i2s -- -DEXTRA_CONF_FILE=broadcast_source/overlay-broadcast_source.conf -DFILE_SUFFIX=fota -DCONFIG_AUDIO_SOURCE_I2S=y'
  topdir: '/home/t/asset-tracker-template'
  version: '1.5.0'
