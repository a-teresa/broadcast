	};

	/* node '/leds' defined in nrf/boards/aurascope/aurascope/aurascope_nrf5340_shared.dtsi:10 */
	leds {
		compatible = "gpio-leds"; /* in nrf/boards/aurascope/aurascope/aurascope_nrf5340_shared.dtsi:11 */

		/* node '/leds/led_0' defined in nrf/boards/aurascope/aurascope/aurascope_nrf5340_shared.dtsi:13 */
