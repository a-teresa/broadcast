			label = "Green LED 0";       /* in nrf/boards/aurascope/aurascope/aurascope_nrf5340_shared.dtsi:15 */
		};

		/* node '/leds/led_1' defined in nrf/boards/aurascope/aurascope/aurascope_nrf5340_shared.dtsi:18 */
