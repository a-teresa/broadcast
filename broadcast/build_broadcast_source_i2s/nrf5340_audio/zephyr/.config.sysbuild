# sysbuild controlled configuration settings
CONFIG_PARTITION_MANAGER_ENABLED=y
CONFIG_BUILD_OUTPUT_BIN=y
CONFIG_BUILD_OUTPUT_HEX=y
CONFIG_PM_EXTERNAL_FLASH_MCUBOOT_SECONDARY=y
CONFIG_MCUBOOT_APPLICATION_IMAGE_NUMBER=0
CONFIG_MCUBOOT_NETWORK_CORE_IMAGE_NUMBER=1
CONFIG_MCUBOOT_WIFI_PATCHES_IMAGE_NUMBER=-1
CONFIG_MCUBOOT_QSPI_XIP_IMAGE_NUMBER=-1
CONFIG_MCUBOOT_MCUBOOT_IMAGE_NUMBER=-1
CONFIG_UPDATEABLE_IMAGE_NUMBER=2
CONFIG_MCUMGR_GRP_IMG_QSPI_XIP_SPLIT_IMAGE=n
CONFIG_PM_OVERRIDE_EXTERNAL_DRIVER_CHECK=y
CONFIG_MCUBOOT_HARDWARE_DOWNGRADE_PREVENTION=n
CONFIG_MCUBOOT_COMPRESSED_IMAGE_SUPPORT_ENABLED=n
CONFIG_WIFI_NRF70=n
CONFIG_CHIP=n
CONFIG_ROM_END_OFFSET=0x180
CONFIG_MCUBOOT_UPDATE_FOOTER_SIZE=0x30
CONFIG_BOOTLOADER_MCUBOOT=y
CONFIG_MCUBOOT_SIGNATURE_KEY_FILE="/home/t/asset-tracker-template/bootloader/mcuboot/root-rsa-2048.pem"
CONFIG_MCUBOOT_ENCRYPTION_KEY_FILE=""
CONFIG_MCUBOOT_GENERATE_UNSIGNED_IMAGE=n
CONFIG_MCUBOOT_BOOTLOADER_MODE_OVERWRITE_ONLY=y
